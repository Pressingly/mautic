# Copy to docker/mpass/.env (gitignored, kept out of the image) for docker-compose.devkit.yml.

# --- Same values as the running mpass-sso-devkit's .env ---
PLATFORM_DOMAIN=foss.local.dev
SMB_NAME=foss
DEFAULT_EMAIL_DOMAIN=
SMB_CORPORATE_ID=
SESSION_TTL_SECONDS=432000

# --- Mautic ---
MAUTIC_DB_PASSWORD=CHANGE_ME
MAUTIC_DB_ROOT_PASSWORD=CHANGE_ME
# At least 32 characters: openssl rand -hex 32
MPASS_EDGE_SECRET=CHANGE_ME
# Id of the "mPass Member" role; mautic-bootstrap prints it on first start.
MPASS_SSO_DEFAULT_ROLE=
