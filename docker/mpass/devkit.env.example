# Append to the mpass-sso-devkit's .env: docker-compose.devkit.yml runs inside the devkit's
# compose project, so it reads the devkit's .env.

# --- Already in the devkit's .env; Mautic uses them as they are ---
# PLATFORM_DOMAIN=foss.local.dev
# SMB_NAME=devkit
# DEFAULT_EMAIL_DOMAIN=askii.ai   (required: the devkit sends a bare mPass id)
# SMB_CORPORATE_ID=
# SESSION_COOKIE_MAX_AGE_SECONDS=432000

# --- Mautic ---
MAUTIC_DB_PASSWORD=CHANGE_ME
MAUTIC_DB_ROOT_PASSWORD=CHANGE_ME
# Optional edge secret (at least 32 characters: openssl rand -hex 32). Empty: topology trust.
MPASS_EDGE_SECRET=
